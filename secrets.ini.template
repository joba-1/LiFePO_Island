; Copy to secrets.ini (untracked, chmod 600).
; admin_password protects /update, /reset, /ip and POST /api/netconfig
; (and the WiFiManager portal if >= 8 characters); upload_script.py uses it
; for OTA uploads. Without it: no admin lock.
; bench_wifi_* are only compiled into envs with custom_bench_wifi = yes
; (atom_echo), so a freshly erased test board joins the network directly.
[secrets]
admin_password =
bench_wifi_ssid =
bench_wifi_password =
